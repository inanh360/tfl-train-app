# Postgres connection string, e.g. from Supabase project settings
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# TfL app key (optional but recommended - raises your rate limit)
# Get one at https://api.tfl.gov.uk/
TFL_APP_KEY=""

PORT=4000

# How often to poll TfL, in milliseconds. Default: every 90 seconds
POLL_INTERVAL_MS=90000

#save to files