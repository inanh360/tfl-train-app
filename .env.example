# Postgres connection string, e.g. from Supabase project settings
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Supabase project settings (Settings -> API) — used to verify auth tokens
# sent by the frontend. Never expose SUPABASE_SERVICE_ROLE_KEY to the
# frontend; it's server-only.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# TfL app key (optional but recommended - raises your rate limit)
# Get one at https://api.tfl.gov.uk/
TFL_APP_KEY=""

PORT=4000

# How often to poll TfL, in milliseconds. Default: every 90 seconds
POLL_INTERVAL_MS=90000

# Your deployed frontend's URL, so CORS only allows your own site once
# this is public. Leave unset in local dev to allow any origin.
FRONTEND_URL=""

# Duplicates of the Supabase URL/anon key, only needed so
# `docker compose up --build` can pass them into the frontend's build
# (NEXT_PUBLIC_ vars get baked into the client bundle at build time, sos
# Compose needs them even though this is otherwise a backend .env file).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
########