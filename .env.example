# Postgres connection string, e.g. from Supabase project settings
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# TfL app key (optional but recommended - raises your rate limit)
# Get one at https://api.tfl.gov.uk/
TFL_APP_KEY=""

PORT=4000

# Cron expression (with seconds) for how often to poll TfL. Default: every 90s
POLL_CRON="*/90 * * * * *"
