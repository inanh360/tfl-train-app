# URL of your Express backend (localhost for local dev, your real
# deployed API URL otherwise)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Supabase project settings (Settings -> API). The anon key is safe to
# expose client-side by design.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Public half of the VAPID key pair used for push notifications. Must
# match VAPID_PUBLIC_KEY in the backend's .env exactly. See the root
# .env.example for how to generate a real key pair.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
